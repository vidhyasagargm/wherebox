{
  "name": "wherebox",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "icons": "node scripts/icons.mjs",
    "test:backend": "node --test --test-concurrency=1 backend/test/*.test.mjs",
    "backend": "backend/.bin/pocketbase serve --dir backend/pb_data --migrationsDir backend/pb_migrations --hooksDir backend/pb_hooks",
    "test:e2e": "node --test --test-concurrency=1 e2e/*.e2e.mjs",
    "app:sync": "vite build && cap sync",
    "app:android": "npm run app:sync && cd android && ./gradlew assembleDebug"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.3",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "8.0.2",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/ios": "8.5.2",
    "@capacitor/share": "8.0.2",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "dexie": "^4.4.6",
    "pocketbase": "^0.28.1"
  },
  "allowScripts": {
    "sharp@0.35.5": true
  },
  "license": "MIT",
  "description": "Remember where you put things. Local-first PWA and Android/iOS app."
}
