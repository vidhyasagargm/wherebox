# Copy to backend.env on the server (never commit the real file).

# Public address of the app, used in emails.
WB_APP_URL=https://wherebox.sagar.fyi

# Sending sign-in codes through Brevo (Settings › SMTP & API in Brevo).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-login@example.com
SMTP_PASS=your-brevo-smtp-key
SMTP_TLS=false
SMTP_FROM=noreply@sagar.fyi
SMTP_FROM_NAME=Wherebox
