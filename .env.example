# Wherebox hosting configuration.
# Copy to .env next to docker-compose.yml, change what you need, then: docker compose up -d
# Docker Compose reads this file automatically.

# ---------------------------------------------------------------------------
# What to run. Pick one:
#   (empty)          the app only: no accounts, everything stays on each device
#   accounts         app + accounts (sync and sharing)
#   accounts,backup  app + accounts + encrypted offsite backups (recommended for a public server)
COMPOSE_PROFILES=

# Port the app listens on, on this machine.
WHEREBOX_PORT=8080

# Image version: latest, or a release like 1.2 or 1.2.0
WHEREBOX_VERSION=latest

# ---------------------------------------------------------------------------
# Accounts (only with the "accounts" profile)

# The address people open, used in emails.
WB_APP_URL=https://wherebox.example.com

# Sending sign-in codes. Any SMTP provider works: Brevo, Mailgun, Postmark, Gmail
# (with an app password), your own mail server…
# Brevo example: SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587, SMTP_USER=<login>, SMTP_PASS=<SMTP key>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# true for port 465 (implicit TLS); false for 587 (STARTTLS)
SMTP_TLS=false
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=Wherebox

# No email server? For a private home network or testing only, sign-in codes can be
# printed in the server log instead:  docker compose logs pocketbase | grep "sign-in code"
# Anyone who can read the log could sign in as anyone. Never enable this on a public server.
WB_LOG_SIGNIN_CODES=false

# ---------------------------------------------------------------------------
# Encrypted backups (only with the "backup" profile)
# Uses restic: everything is encrypted with RESTIC_PASSWORD before it leaves this machine.
# KEEP THE PASSWORD SAFE AND SOMEWHERE ELSE: without it the backups can't be restored.

# Where to store backups, for example:
#   sftp:u123456@u123456.your-storagebox.de:wherebox     (Hetzner Storage Box, SSH key needed)
#   s3:https://s3.eu-central-003.backblazeb2.com/my-bucket/wherebox   (Backblaze B2, S3 API)
#   /backups                                               (a disk mounted into the container)
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
# For S3-compatible storage:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# When to back up each day (container time, UTC).
BACKUP_TIME=03:15
